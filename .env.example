# ── MatchFlow — Place-IL Quest #2 ──────────────────────────────────────────

# Brain API (FastAPI)
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8001
BRAIN_API_KEY=change-me-to-a-long-random-string

# OpenAI (entity extraction, match score, cover letter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Notion CRM — create integration at https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Telegram manual trigger
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# Alerts when match_score >= 80
ALERT_THRESHOLD=80
# Only write to Notion from RSS when score >= this (0 = save all)
NOTION_MIN_SCORE=0
SLACK_WEBHOOK_URL=
# Optional: also send via Telegram (same bot or second channel)
TELEGRAM_ALERT_CHAT_ID=

# RSS / automatic trigger (used by n8n or cron)
RSS_FEED_URL=https://remoteok.com/remote-junior-jobs.rss

# Public URL of Brain API (for n8n / Telegram) — Render production:
MATCHFLOW_BRAIN_URL=https://matchflow-tgvm.onrender.com
# Local override when developing Brain on your PC:
# MATCHFLOW_BRAIN_URL=http://127.0.0.1:8001

# GitHub — enriches matching with repo languages (CSS, HTML, etc.)
GITHUB_USERNAME=AseelHerzallah1

# Telegram — skip startup connectivity check if network is flaky
# SKIP_TELEGRAM_CHECK=true
